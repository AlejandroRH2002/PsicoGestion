---
import AppLayout from '../../layouts/AppLayout.astro';
import FormField from '../../components/FormField.astro';
import SelectField from '../../components/SelectField.astro';
import FileDropzone from '../../components/FileDropzone.astro';

// Opciones de sexo alineadas con el esquema de base de datos (CHECK sexo IN ('M', 'F', 'O'))
const sexOptions = [
  { value: 'F', label: 'Femenino' },
  { value: 'M', label: 'Masculino' },
  { value: 'O', label: 'Otro' },
];
---

<AppLayout 
  title="Registrar Nuevo Paciente" 
  activo="pacientes"
  volverHref="/pacientes" 
  volverEtiqueta="Volver a pacientes"
>
  <div class="w-full max-w-3xl bg-white rounded-2xl border border-border-input p-8 md:p-10 shadow-xs">
    <div class="mb-8">
      <h3 class="text-xl font-bold text-title">Información del Paciente</h3>
      <p class="text-sm text-subtext mt-1">
        Complete el formulario para dar de alta al nuevo paciente en el sistema institucional.
      </p>
    </div>

    <form id="patient-form" class="space-y-6" novalidate>
      <!-- Nombre Completo con contador de caracteres -->
      <FormField 
        id="fullName" 
        name="fullName" 
        label="Nombre completo" 
        placeholder="Ej. Carlos Ramírez Mendoza" 
        maxlength={50} 
        showCounter={true} 
        helperText="Máximo 50 caracteres" 
      />

      <!-- CURP y Sexo -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <FormField 
          id="curp" 
          name="curp" 
          label="CURP" 
          placeholder="Ej. RAMC950320HDFMNN02" 
          maxlength={18} 
          helperText="18 caracteres alfanuméricos oficiales" 
        />

        <SelectField 
          id="gender" 
          name="gender" 
          label="Sexo" 
          placeholder="Seleccione opción" 
          options={sexOptions} 
        />
      </div>

      <!-- Fecha de Nacimiento y Teléfono -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <FormField 
          id="birthDate" 
          name="birthDate" 
          label="Fecha de nacimiento" 
          placeholder="dd/mm/aaaa" 
          maxlength={10} 
          helperText="Formato: dd/mm/aaaa • Edad mínima: 7 años" 
        />

        <FormField 
          id="phone" 
          name="phone" 
          type="tel" 
          label="Teléfono" 
          placeholder="Ej. 999 123 4567" 
          maxlength={10}
          helperText="Debe ser de 10 dígitos numéricos" 
        />
      </div>

      <!-- Archivos Adjuntos (Expediente, Consentimiento, Identificación, etc.) -->
      <FileDropzone id="attachments" name="attachments" maxSizeMB={5} />

      <!-- Banner de Feedback General -->
      <div id="status-banner" class="hidden p-4 rounded-xl text-sm font-medium" role="alert"></div>

      <!-- Botones de Acción -->
      <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100">
        <button 
          type="button" 
          id="cancel-btn" 
          class="px-6 py-2.5 rounded-xl border border-border-input text-label hover:bg-slate-50 font-semibold transition-colors cursor-pointer"
        >
          Cancelar
        </button>
        <button 
          type="submit" 
          id="submit-btn" 
          class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-brand-teal hover:bg-brand-teal-hover text-white font-semibold transition-colors shadow-xs cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submit-spinner" class="hidden animate-spin">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="submit-text">Guardar Paciente</span>
        </button>
      </div>
    </form>
  </div>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';

    // Elementos del formulario principal
    const form = document.getElementById('patient-form') as HTMLFormElement | null;
    const fullNameInput = document.getElementById('fullName') as HTMLInputElement | null;
    const nameCounter = document.getElementById('fullName-counter') as HTMLSpanElement | null;
    const curpInput = document.getElementById('curp') as HTMLInputElement | null;
    const genderSelect = document.getElementById('gender') as HTMLSelectElement | null;
    const birthDateInput = document.getElementById('birthDate') as HTMLInputElement | null;
    const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const submitSpinner = document.getElementById('submit-spinner') as HTMLElement | null;
    const submitText = document.getElementById('submit-text') as HTMLElement | null;
    const cancelBtn = document.getElementById('cancel-btn') as HTMLButtonElement | null;
    const statusBanner = document.getElementById('status-banner') as HTMLDivElement | null;

    // Elementos del componente FileDropzone
    const fileDropzone = document.getElementById('file-dropzone') as HTMLDivElement | null;
    const attachmentsInput = document.getElementById('attachments') as HTMLInputElement | null;
    const fileListContainer = document.getElementById('file-list-container') as HTMLDivElement | null;

    let selectedFiles: File[] = [];
    let dragCounter = 0;

    // Accesibilidad de teclado para el Dropzone
    if (fileDropzone) {
      fileDropzone.setAttribute('tabindex', '0');
      fileDropzone.setAttribute('role', 'button');
      fileDropzone.setAttribute('aria-label', 'Subir archivos adjuntos');
      fileDropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          attachmentsInput?.click();
        }
      });
    }

    // 1. Contador de caracteres del Nombre Completo
    fullNameInput?.addEventListener('input', () => {
      if (nameCounter) {
        nameCounter.textContent = `${fullNameInput.value.length} / 50`;
      }
      clearError('fullName');
    });

    // 2. Normalización de CURP (Mayúsculas automáticas y filtrado alfanumérico)
    curpInput?.addEventListener('input', () => {
      curpInput.value = curpInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 18);
      clearError('curp');
    });

    // 3. Normalización de Teléfono (Solo 10 dígitos)
    phoneInput?.addEventListener('input', () => {
      phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 10);
      clearError('phone');
    });

    genderSelect?.addEventListener('change', () => clearError('gender'));

    // 4. Máscara de entrada para Fecha de Nacimiento (dd/mm/aaaa)
    birthDateInput?.addEventListener('input', (e) => {
      const inputEvent = e as InputEvent;
      if (inputEvent.inputType === 'deleteContentBackward') {
        clearError('birthDate');
        return;
      }

      let val = birthDateInput.value.replace(/\D/g, '');
      if (val.length > 8) val = val.slice(0, 8);
      if (val.length >= 5) {
        val = `${val.slice(0, 2)}/${val.slice(2, 4)}/${val.slice(4)}`;
      } else if (val.length >= 3) {
        val = `${val.slice(0, 2)}/${val.slice(2)}`;
      }
      birthDateInput.value = val;
      clearError('birthDate');
    });

    // 5. Manejo de Drag & Drop para Archivos Adjuntos con prevención de parpadeo
    fileDropzone?.addEventListener('click', () => attachmentsInput?.click());

    fileDropzone?.addEventListener('dragenter', (e) => {
      e.preventDefault();
      dragCounter++;
      fileDropzone.classList.add('bg-teal-50/80', 'border-brand-teal');
    });

    fileDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
    });

    fileDropzone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dragCounter--;
      if (dragCounter <= 0) {
        dragCounter = 0;
        fileDropzone.classList.remove('bg-teal-50/80', 'border-brand-teal');
      }
    });

    fileDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dragCounter = 0;
      fileDropzone.classList.remove('bg-teal-50/80', 'border-brand-teal');
      if (e.dataTransfer?.files) {
        handleIncomingFiles(Array.from(e.dataTransfer.files));
      }
    });

    attachmentsInput?.addEventListener('change', () => {
      if (attachmentsInput.files) {
        handleIncomingFiles(Array.from(attachmentsInput.files));
      }
    });

    // Procesa y valida cada archivo entrante
    function handleIncomingFiles(files: File[]) {
      clearError('attachments');
      const validTypes = ['application/pdf', 'image/jpeg', 'image/png'];
      const validExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];
      const maxBytes = 5 * 1024 * 1024; // 5 MB

      for (const file of files) {
        const fileExt = '.' + file.name.split('.').pop()?.toLowerCase();
        const isValidType = validTypes.includes(file.type) || validExtensions.includes(fileExt);

        if (!isValidType) {
          showError('attachments', `El archivo "${file.name}" tiene un formato no permitido. Solo se aceptan PDF, JPG o PNG.`);
          return;
        }

        if (file.size > maxBytes) {
          showError('attachments', `"${file.name}" supera el tamaño máximo permitido de 5 MB.`);
          return;
        }

        // Evitar duplicados por nombre y tamaño exacto
        const isDuplicate = selectedFiles.some(f => f.name === file.name && f.size === file.size);
        if (!isDuplicate) {
          selectedFiles.push(file);
        }
      }

      // Reiniciar el input file para permitir volver a cargar un archivo previamente eliminado
      if (attachmentsInput) {
        attachmentsInput.value = '';
      }

      renderFileList();
    }

    // Renderiza la lista visual de archivos cargados
    function renderFileList() {
      if (!fileListContainer) return;

      if (selectedFiles.length === 0) {
        fileListContainer.classList.add('hidden');
        fileListContainer.innerHTML = '';
        return;
      }

      fileListContainer.classList.remove('hidden');
      fileListContainer.innerHTML = '';

      selectedFiles.forEach((file, index) => {
        const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
        const sizeFormatted = file.size >= 1024 * 1024 
          ? `${(file.size / (1024 * 1024)).toFixed(2)} MB` 
          : `${Math.round(file.size / 1024)} KB`;

        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-3 bg-slate-50 border border-border-input rounded-xl text-xs hover:bg-slate-100/60 transition-colors';

        item.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <span class="font-bold px-2 py-0.5 rounded text-[10px] tracking-wider uppercase ${isPdf ? 'bg-rose-100 text-rose-700 border border-rose-200' : 'bg-teal-100 text-teal-700 border border-teal-200'}">
              ${isPdf ? 'PDF' : 'IMG'}
            </span>
            <div class="min-w-0">
              <p class="truncate font-semibold text-title text-sm max-w-[200px] sm:max-w-xs md:max-w-sm" title="${file.name}">
                ${file.name}
              </p>
              <p class="text-[11px] text-subtext">${sizeFormatted}</p>
            </div>
          </div>
          <button 
            type="button" 
            data-index="${index}" 
            aria-label="Eliminar ${file.name}"
            class="delete-file-btn p-1.5 rounded-lg text-subtext hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        `;

        item.querySelector('.delete-file-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          selectedFiles.splice(index, 1);
          renderFileList();
          if (selectedFiles.length > 0) {
            clearError('attachments');
          }
        });

        fileListContainer.appendChild(item);
      });
    }

    // 6. Validación completa de Fecha y Edad Mínima (7 años cumplidos)
    function validateBirthDate(birthDateStr: string): { valid: boolean; message?: string } {
      const parts = birthDateStr.split('/');
      if (parts.length !== 3) {
        return { valid: false, message: 'Ingrese una fecha válida en formato dd/mm/aaaa.' };
      }

      const day = parseInt(parts[0], 10);
      const month = parseInt(parts[1], 10) - 1; // 0-indexado
      const year = parseInt(parts[2], 10);

      const currentYear = new Date().getFullYear();
      if (isNaN(year) || year < 1900 || year > currentYear) {
        return { valid: false, message: 'El año de nacimiento no es válido.' };
      }

      // Verificación estricta en calendario (evita días imposibles como 31/02)
      const birthDate = new Date(year, month, day);
      if (
        birthDate.getFullYear() !== year ||
        birthDate.getMonth() !== month ||
        birthDate.getDate() !== day
      ) {
        return { valid: false, message: 'La fecha ingresada no existe en el calendario.' };
      }

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      if (birthDate >= today) {
        return { valid: false, message: 'La fecha de nacimiento debe ser anterior a la fecha actual.' };
      }

      // Cálculo de edad exacta
      let age = today.getFullYear() - birthDate.getFullYear();
      const monthDiff = today.getMonth() - birthDate.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
        age--;
      }

      if (age < 7) {
        return { valid: false, message: 'El paciente debe tener al menos 7 años cumplidos.' };
      }

      return { valid: true };
    }

    // Funciones de Error UI y Accesibilidad
    function showError(field: string, msg: string) {
      const errorEl = document.getElementById(`error-${field}`);
      const inputEl = document.getElementById(field);

      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
        errorEl.setAttribute('role', 'alert');
      }

      if (field === 'attachments') {
        const dropzoneEl = document.getElementById('file-dropzone');
        dropzoneEl?.classList.add('!border-error');
      } else if (inputEl) {
        inputEl.classList.add('border-error');
        inputEl.setAttribute('aria-invalid', 'true');
      }
    }

    function clearError(field: string) {
      const errorEl = document.getElementById(`error-${field}`);
      const inputEl = document.getElementById(field);

      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.removeAttribute('role');
      }

      if (field === 'attachments') {
        const dropzoneEl = document.getElementById('file-dropzone');
        dropzoneEl?.classList.remove('!border-error');
      } else if (inputEl) {
        inputEl.classList.remove('border-error');
        inputEl.removeAttribute('aria-invalid');
      }
    }

    // Botón Cancelar con redirección
    cancelBtn?.addEventListener('click', () => {
      window.location.href = '/pacientes';
    });

    // Envío Asíncrono del Formulario con Validación Robusta
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (statusBanner) {
        statusBanner.className = 'hidden p-4 rounded-xl text-sm font-medium';
        statusBanner.textContent = '';
      }

      let hasErrors = false;
      let firstErrorField: HTMLElement | null = null;

      function registerError(field: string, message: string, elementToFocus: HTMLElement | null) {
        showError(field, message);
        hasErrors = true;
        if (!firstErrorField && elementToFocus) {
          firstErrorField = elementToFocus;
        }
      }

      // 1. Nombre completo
      const fullNameVal = fullNameInput?.value.trim() ?? '';
      if (!fullNameVal) {
        registerError('fullName', 'El nombre completo es obligatorio.', fullNameInput);
      } else if (fullNameVal.length > 50) {
        registerError('fullName', 'El nombre completo no puede exceder 50 caracteres.', fullNameInput);
      } else if (fullNameVal.length < 3) {
        registerError('fullName', 'El nombre completo debe tener al menos 3 caracteres.', fullNameInput);
      }

      // 2. CURP (18 caracteres oficiales de México)
      const curpVal = curpInput?.value.trim().toUpperCase() ?? '';
      const curpRegex = /^[A-Z]{4}\d{6}[HM][A-Z]{5}[0-9A-Z]\d$/;
      if (!curpVal) {
        registerError('curp', 'La CURP es obligatoria.', curpInput);
      } else if (curpVal.length !== 18 || !curpRegex.test(curpVal)) {
        registerError('curp', 'Ingresa una CURP oficial válida de 18 caracteres (ej. RAMC950320HDFMNN02).', curpInput);
      }

      // 3. Sexo (M, F, O)
      const genderVal = genderSelect?.value ?? '';
      if (!genderVal) {
        registerError('gender', 'Debes seleccionar el sexo del paciente.', genderSelect);
      }

      // 4. Fecha de nacimiento
      const birthDateVal = birthDateInput?.value.trim() ?? '';
      if (!birthDateVal) {
        registerError('birthDate', 'La fecha de nacimiento es obligatoria.', birthDateInput);
      } else {
        const dateValidation = validateBirthDate(birthDateVal);
        if (!dateValidation.valid) {
          registerError('birthDate', dateValidation.message ?? 'Fecha de nacimiento inválida.', birthDateInput);
        }
      }

      // 5. Teléfono
      const cleanPhone = (phoneInput?.value ?? '').replace(/\D/g, '');
      if (!cleanPhone) {
        registerError('phone', 'El teléfono es obligatorio.', phoneInput);
      } else if (cleanPhone.length !== 10) {
        registerError('phone', 'Debe contener un número telefónico válido de 10 dígitos.', phoneInput);
      }

      // 6. Archivos adjuntos (Mínimo 1 archivo obligatorio)
      if (selectedFiles.length === 0) {
        registerError('attachments', 'Debes adjuntar al menos un archivo (PDF, JPG o PNG).', fileDropzone);
      }

      // Si hay errores, detener envío y enfocar el primer elemento fallido
      if (hasErrors) {
        firstErrorField?.focus();
        firstErrorField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      // Estado de carga del botón
      if (submitBtn) submitBtn.disabled = true;
      submitSpinner?.classList.remove('hidden');
      if (submitText) submitText.textContent = 'Guardando...';

      // Construcción del payload multipart/form-data
      const formData = new FormData();
      formData.append('nombre_completo', fullNameVal);
      formData.append('curp', curpVal);
      formData.append('sexo', genderVal);
      formData.append('fecha_nacimiento', birthDateVal);
      formData.append('telefono', cleanPhone);

      selectedFiles.forEach((file) => {
        formData.append('archivos', file);
      });

      try {
        const response = await fetch(`${API_URL}/pacientes`, {
          method: 'POST',
          credentials: 'include', // Incluye cookies de sesión HttpOnly
          body: formData,
        });

        const result = await response.json().catch(() => null);

        if (!response.ok) {
          if (result && Array.isArray(result.errors)) {
            // Mapeo seguro de nombres de columnas de backend a IDs del formulario
            const fieldMap: Record<string, string> = {
              nombre_completo: 'fullName',
              curp: 'curp',
              sexo: 'gender',
              fecha_nacimiento: 'birthDate',
              telefono: 'phone',
              archivos: 'attachments',
            };

            result.errors.forEach((err: { field: string; message: string }) => {
              const fieldId = fieldMap[err.field] || err.field;
              showError(fieldId, err.message);
            });
          } else {
            throw new Error(result?.error || result?.message || 'Error en el servidor al registrar el paciente.');
          }
          return;
        }

        // Éxito
        if (statusBanner) {
          statusBanner.textContent = 'Paciente registrado con éxito. Redirigiendo a la lista de pacientes...';
          statusBanner.className = 'block p-4 rounded-xl text-sm font-semibold bg-emerald-50 text-uady-green border border-emerald-200';
          statusBanner.setAttribute('role', 'status');
        }

        form.reset();
        selectedFiles = [];
        renderFileList();

        setTimeout(() => {
          window.location.href = '/pacientes';
        }, 1500);

      } catch (err: any) {
        if (statusBanner) {
          statusBanner.textContent = err.message || 'Ocurrió un error inesperado al conectar con el servidor.';
          statusBanner.className = 'block p-4 rounded-xl text-sm font-semibold bg-rose-50 text-rose-700 border border-rose-200';
          statusBanner.setAttribute('role', 'alert');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        submitSpinner?.classList.add('hidden');
        if (submitText) submitText.textContent = 'Guardar Paciente';
      }
    });
  </script>
</AppLayout>
