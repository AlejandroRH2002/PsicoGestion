---
import { Calendar, CalendarDays, ChevronLeft, ChevronRight, Pencil, Plus, Search, Trash2, X } from '@lucide/astro';
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Gestión de Citas" activo="citas">
  <div class="w-full max-w-7xl flex flex-col gap-6">
    <!-- Encabezado Principal -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-1">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">Directorio de Citas</h1>
        <p class="text-sm text-[#64748B]">Revise, edite o cancele citas médicas registradas en el sistema.</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/citas/calendario"
          class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 border border-[#E2E8F0] text-[#334155] text-sm font-semibold px-3.5 py-2.5 rounded-xl transition-all shadow-2xs"
          title="Ver en formato calendario"
        >
          <Calendar class="size-4 text-[#0D9488]" />
          <span>Calendario</span>
        </a>
        <a
          href="/citas/nueva"
          class="inline-flex items-center gap-2 bg-[#0D9488] hover:bg-[#0f766e] text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-xs"
        >
          <Plus class="size-4" />
          <span>Agendar Cita</span>
        </a>
      </div>
    </div>

    <!-- Pestañas de Estado con Contadores -->
    <div class="border-b border-[#E2E8F0] flex items-center gap-3 overflow-x-auto pb-px" role="tablist">
      <button
        type="button"
        id="tab-todas"
        data-estado="Todas"
        class="tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A] hover:bg-slate-50"
      >
        <span>Todas</span>
        <span id="badge-todas" class="px-2 py-0.5 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#64748B]">0</span>
      </button>

      <button
        type="button"
        id="tab-pendientes"
        data-estado="Pendiente"
        class="tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold transition-all cursor-pointer border border-[#0D9488] text-[#0D9488] bg-white shadow-2xs"
      >
        <span>Pendientes</span>
        <span id="badge-pendientes" class="px-2 py-0.5 rounded-full text-xs font-bold bg-[#0D9488] text-white">0</span>
      </button>

      <button
        type="button"
        id="tab-canceladas"
        data-estado="Cancelada"
        class="tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A] hover:bg-slate-50"
      >
        <span>Canceladas</span>
        <span id="badge-canceladas" class="px-2 py-0.5 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#64748B]">0</span>
      </button>

      <button
        type="button"
        id="tab-vencidas"
        data-estado="Vencida"
        class="tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A] hover:bg-slate-50"
      >
        <span>Vencidas</span>
        <span id="badge-vencidas" class="px-2 py-0.5 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#64748B]">0</span>
      </button>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
      <!-- Buscador -->
      <div class="relative flex-1 max-w-md">
        <Search class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-[#94A3B8]" />
        <input
          id="input-busqueda"
          type="search"
          placeholder="Buscar por paciente o folio..."
          class="w-full h-10 pl-10 pr-4 text-sm rounded-xl border border-[#E2E8F0] bg-white text-[#0F172A] placeholder:text-[#94A3B8] focus:outline-none focus:border-[#0D9488] focus:ring-2 focus:ring-[#0D9488]/20 transition-all shadow-2xs"
        />
      </div>

      <!-- Selectores de Sala, Terapeuta y Rango Temporal -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Filtro Sala -->
        <select
          id="filtro-sala"
          class="h-10 pl-3 pr-8 text-sm font-medium rounded-xl border border-[#E2E8F0] bg-white text-[#334155] focus:outline-none focus:border-[#0D9488] cursor-pointer shadow-2xs"
        >
          <option value="">Sala: Todas</option>
        </select>

        <!-- Filtro Terapeuta -->
        <select
          id="filtro-terapeuta"
          class="h-10 pl-3 pr-8 text-sm font-medium rounded-xl border border-[#E2E8F0] bg-white text-[#334155] focus:outline-none focus:border-[#0D9488] cursor-pointer shadow-2xs"
        >
          <option value="">Terapeuta: Todos</option>
        </select>

        <!-- Selector Temporal (Pills) -->
        <div class="flex items-center p-1 bg-[#F1F5F9]/80 rounded-xl border border-[#E2E8F0] text-xs font-semibold text-[#64748B]">
          <button
            type="button"
            data-tiempo="todos"
            class="tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A]"
          >
            Todos
          </button>
          <button
            type="button"
            data-tiempo="dia"
            class="tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A]"
          >
            Día
          </button>
          <button
            type="button"
            data-tiempo="semana"
            class="tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer bg-white text-[#0F172A] shadow-2xs font-bold"
          >
            Semana
          </button>
          <button
            type="button"
            data-tiempo="mes"
            class="tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A]"
          >
            Mes
          </button>
        </div>
      </div>
    </div>

    <!-- Tarjeta Tabla de Citas -->
    <div class="bg-white border border-[#E2E8F0] rounded-2xl shadow-xs overflow-hidden flex flex-col">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-[#E2E8F0] bg-[#F8FAFC]/50 text-xs font-bold text-[#64748B]">
              <th scope="col" class="py-3.5 pl-6 pr-4">Folio</th>
              <th scope="col" class="py-3.5 px-4">Paciente</th>
              <th scope="col" class="py-3.5 px-4">Terapeuta</th>
              <th scope="col" class="py-3.5 px-4">Sala</th>
              <th scope="col" class="py-3.5 px-4">Fecha y Hora</th>
              <th scope="col" class="py-3.5 px-4">Estatus</th>
              <th scope="col" class="py-3.5 pl-4 pr-6 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="citas-table-body" class="divide-y divide-[#E2E8F0] text-sm text-[#0F172A]">
            <!-- Filas dinámicas inyectadas vía JS -->
            <tr>
              <td colspan="7" class="py-12 text-center text-[#64748B]">
                <div class="flex flex-col items-center justify-center gap-2">
                  <div class="size-6 border-2 border-[#0D9488] border-t-transparent rounded-full animate-spin"></div>
                  <span class="text-xs">Cargando directorio de citas...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pie de Tabla: Paginación y Contador -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 border-t border-[#E2E8F0] bg-white text-xs text-[#64748B]">
        <div id="paginacion-resumen">
          Mostrando <span id="pag-inicio">0</span> de <span id="pag-total">0</span> registros
        </div>

        <div class="flex items-center gap-1.5 self-center sm:self-auto" id="paginacion-controles">
          <button
            type="button"
            id="btn-prev-page"
            disabled
            class="px-3 py-1.5 border border-[#E2E8F0] rounded-lg font-semibold text-[#64748B] hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            Anterior
          </button>
          <div id="paginacion-numeros" class="flex items-center gap-1">
            <!-- Botones numéricos dinámicos -->
          </div>
          <button
            type="button"
            id="btn-next-page"
            disabled
            class="px-3 py-1.5 border border-[#E2E8F0] rounded-lg font-semibold text-[#64748B] hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            Siguiente
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Confirmación para Cancelar Cita -->
  <div id="modal-cancelar" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-xs p-4" role="dialog" aria-modal="true">
    <div class="w-full max-w-md bg-white rounded-2xl p-6 shadow-xl border border-[#E2E8F0] flex flex-col gap-4">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-[#0F172A]">Cancelar Cita</h3>
        <button type="button" id="btn-cerrar-modal-cancelar" class="p-1 rounded-lg hover:bg-slate-100 text-[#64748B]">
          <X class="size-5" />
        </button>
      </div>
      <p class="text-sm text-[#475569]">
        ¿Está seguro de que desea cancelar la cita <strong id="modal-cancelar-folio" class="text-[#0F172A]"></strong>? Esta acción actualizará su estado a "Cancelada".
      </p>
      <div class="flex items-center justify-end gap-3 mt-2">
        <button type="button" id="btn-abortar-cancelar" class="px-4 py-2 border border-[#CBD5E1] rounded-xl text-sm font-semibold text-[#334155] hover:bg-slate-50">
          No, conservar
        </button>
        <button type="button" id="btn-confirmar-cancelar" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-semibold shadow-xs">
          Sí, cancelar cita
        </button>
      </div>
    </div>
  </div>

  <script>
    import {
      listarCitasApi,
      cancelarCitaApi,
      listarSalasApi,
      listarTerapeutasApi,
      formatearFechaTabla,
      type CitaItem,
      type FiltrosCitas,
      type EstadoCita,
    } from '../../utils/citas';

    let estadoActivo = 'Pendiente';
    let tiempoActivo: 'dia' | 'semana' | 'mes' | 'todos' = 'semana';
    let paginaActual = 1;
    let busquedaQuery = '';
    let salaSeleccionada = '';
    let terapeutaSeleccionado = '';
    let citaParaCancelarId: number | null = null;
    let timerBusqueda: number | undefined;

    // Elementos DOM
    const tableBody = document.getElementById('citas-table-body')!;
    const inputBusqueda = document.getElementById('input-busqueda') as HTMLInputElement;
    const selectSala = document.getElementById('filtro-sala') as HTMLSelectElement;
    const selectTerapeuta = document.getElementById('filtro-terapeuta') as HTMLSelectElement;
    const pagInicio = document.getElementById('pag-inicio')!;
    const pagTotal = document.getElementById('pag-total')!;
    const btnPrevPage = document.getElementById('btn-prev-page') as HTMLButtonElement;
    const btnNextPage = document.getElementById('btn-next-page') as HTMLButtonElement;
    const paginacionNumeros = document.getElementById('paginacion-numeros')!;

    const badgeTodas = document.getElementById('badge-todas')!;
    const badgePendientes = document.getElementById('badge-pendientes')!;
    const badgeCanceladas = document.getElementById('badge-canceladas')!;
    const badgeVencidas = document.getElementById('badge-vencidas')!;

    const modalCancelar = document.getElementById('modal-cancelar')!;
    const modalCancelarFolio = document.getElementById('modal-cancelar-folio')!;
    const btnCerrarModalCancelar = document.getElementById('btn-cerrar-modal-cancelar')!;
    const btnAbortarCancelar = document.getElementById('btn-abortar-cancelar')!;
    const btnConfirmarCancelar = document.getElementById('btn-confirmar-cancelar')!;

    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-filtro');
    const tiempoPills = document.querySelectorAll<HTMLButtonElement>('.tiempo-pill');

    function actualizarEstilosTabs(): void {
      tabs.forEach((tab) => {
        const estado = tab.getAttribute('data-estado');
        const badge = tab.querySelector('span:last-child');
        const esActivo = estado === estadoActivo;

        if (esActivo) {
          tab.className = 'tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold transition-all cursor-pointer border border-[#0D9488] text-[#0D9488] bg-white shadow-2xs';
          if (badge) badge.className = 'px-2 py-0.5 rounded-full text-xs font-bold bg-[#0D9488] text-white';
        } else {
          tab.className = 'tab-filtro flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A] hover:bg-slate-50';
          if (badge) badge.className = 'px-2 py-0.5 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#64748B]';
        }
      });
    }

    function actualizarEstilosTiempo(): void {
      tiempoPills.forEach((pill) => {
        const tiempo = pill.getAttribute('data-tiempo');
        const esActivo = tiempo === tiempoActivo;
        if (esActivo) {
          pill.className = 'tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer bg-white text-[#0F172A] shadow-2xs font-bold';
        } else {
          pill.className = 'tiempo-pill px-3 py-1.5 rounded-lg transition-all cursor-pointer text-[#64748B] hover:text-[#0F172A] font-semibold';
        }
      });
    }

    function renderizarBadgeEstatus(estado: EstadoCita): string {
      if (estado === 'Pendiente') {
        return `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#FEF3C7] text-[#B45309] border border-[#FDE68A]/60">Pendiente</span>`;
      }
      if (estado === 'Cancelada') {
        return `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#FEE2E2] text-[#DC2626] border border-[#FECACA]/60">Cancelada</span>`;
      }
      return `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#64748B] border border-[#E2E8F0]">Vencida</span>`;
    }

    async function cargarDirectorio(): Promise<void> {
      tableBody.innerHTML = `
        <tr>
          <td colspan="7" class="py-12 text-center text-[#64748B]">
            <div class="flex flex-col items-center justify-center gap-2">
              <div class="size-6 border-2 border-[#0D9488] border-t-transparent rounded-full animate-spin"></div>
              <span class="text-xs">Cargando directorio de citas...</span>
            </div>
          </td>
        </tr>
      `;

      try {
        const filtros: FiltrosCitas = {
          q: busquedaQuery,
          estado: estadoActivo,
          salaId: salaSeleccionada || undefined,
          terapeutaId: terapeutaSeleccionado || undefined,
          tiempo: tiempoActivo,
          page: paginaActual,
          limit: 6,
        };

        const res = await listarCitasApi(filtros);

        // Actualizar contadores
        if (res.contadores) {
          badgeTodas.textContent = String(res.contadores.todas);
          badgePendientes.textContent = String(res.contadores.pendientes);
          badgeCanceladas.textContent = String(res.contadores.canceladas);
          badgeVencidas.textContent = String(res.contadores.vencidas);
        }

        // Paginación
        pagTotal.textContent = String(res.total);
        pagInicio.textContent = String(res.citas.length);

        btnPrevPage.disabled = paginaActual <= 1;
        btnNextPage.disabled = paginaActual >= res.totalPages;

        // Renderizar números de página
        paginacionNumeros.innerHTML = '';
        for (let p = 1; p <= res.totalPages; p++) {
          const btnNum = document.createElement('button');
          btnNum.type = 'button';
          btnNum.textContent = String(p);
          const esActual = p === paginaActual;
          btnNum.className = `size-8 rounded-lg text-xs font-bold transition-all ${
            esActual
              ? 'bg-[#0D9488] text-white shadow-xs'
              : 'border border-[#E2E8F0] text-[#64748B] hover:bg-slate-50'
          }`;
          btnNum.addEventListener('click', () => {
            paginaActual = p;
            cargarDirectorio();
          });
          paginacionNumeros.appendChild(btnNum);
        }

        // Renderizar filas de la tabla
        if (res.citas.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="7" class="py-12 text-center text-[#64748B]">
                <div class="flex flex-col items-center justify-center gap-2">
                  <p class="font-semibold text-sm text-[#0F172A]">No se encontraron citas</p>
                  <p class="text-xs text-[#64748B]">Pruebe con otros filtros o agende una nueva cita en el sistema.</p>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        tableBody.innerHTML = '';
        res.citas.forEach((cita) => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50/70 transition-colors';

          const fechaHoraFormateada = formatearFechaTabla(cita.fecha, cita.horaInicio);

          tr.innerHTML = `
            <td class="py-4 pl-6 pr-4 font-bold text-sm text-[#0F172A] tracking-tight whitespace-nowrap">${cita.folio}</td>
            <td class="py-4 px-4 font-bold text-sm text-[#0F172A]">${cita.paciente}</td>
            <td class="py-4 px-4 text-sm text-[#475569]">${cita.terapeuta}</td>
            <td class="py-4 px-4 text-sm text-[#475569] whitespace-nowrap">${cita.sala}</td>
            <td class="py-4 px-4 text-sm text-[#475569] whitespace-nowrap">${fechaHoraFormateada}</td>
            <td class="py-4 px-4 whitespace-nowrap">${renderizarBadgeEstatus(cita.estado)}</td>
            <td class="py-4 pl-4 pr-6 text-center whitespace-nowrap">
              <div class="inline-flex items-center gap-1.5 justify-center">
                <a
                  href="/citas/editar?id=${cita.id}"
                  class="p-1.5 text-[#64748B] hover:text-[#0D9488] hover:bg-teal-50 rounded-lg transition-colors cursor-pointer"
                  title="Editar cita"
                >
                  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                </a>
                <button
                  type="button"
                  data-id="${cita.id}"
                  data-folio="${cita.folio}"
                  class="btn-cancelar p-1.5 text-[#DC2626] hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors cursor-pointer"
                  title="Cancelar cita"
                >
                  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                </button>
              </div>
            </td>
          `;

          const btnCancelar = tr.querySelector('.btn-cancelar') as HTMLButtonElement;
          btnCancelar?.addEventListener('click', () => {
            citaParaCancelarId = cita.id;
            modalCancelarFolio.textContent = cita.folio;
            modalCancelar.classList.remove('hidden');
            modalCancelar.classList.add('flex');
          });

          tableBody.appendChild(tr);
        });
      } catch (err) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-red-600 font-medium">
              Error al cargar citas. Por favor intente nuevamente.
            </td>
          </tr>
        `;
      }
    }

    async function cargarFiltrosIniciales(): Promise<void> {
      try {
        const [salas, terapeutas] = await Promise.all([
          listarSalasApi(),
          listarTerapeutasApi(),
        ]);

        salas.forEach((s) => {
          const opt = document.createElement('option');
          opt.value = String(s.id);
          opt.textContent = `Sala: ${s.nombre}`;
          selectSala.appendChild(opt);
        });

        terapeutas.forEach((t) => {
          const opt = document.createElement('option');
          opt.value = String(t.id);
          opt.textContent = `Terapeuta: ${t.nombre}`;
          selectTerapeuta.appendChild(opt);
        });
      } catch (e) {
        console.error('Error cargando listas de filtros:', e);
      }
    }

    // Manejadores de eventos
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        estadoActivo = tab.getAttribute('data-estado') || 'Pendiente';
        paginaActual = 1;
        actualizarEstilosTabs();
        cargarDirectorio();
      });
    });

    tiempoPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        tiempoActivo = (pill.getAttribute('data-tiempo') as any) || 'semana';
        paginaActual = 1;
        actualizarEstilosTiempo();
        cargarDirectorio();
      });
    });

    inputBusqueda.addEventListener('input', () => {
      window.clearTimeout(timerBusqueda);
      timerBusqueda = window.setTimeout(() => {
        busquedaQuery = inputBusqueda.value.trim();
        paginaActual = 1;
        cargarDirectorio();
      }, 300);
    });

    selectSala.addEventListener('change', () => {
      salaSeleccionada = selectSala.value;
      paginaActual = 1;
      cargarDirectorio();
    });

    selectTerapeuta.addEventListener('change', () => {
      terapeutaSeleccionado = selectTerapeuta.value;
      paginaActual = 1;
      cargarDirectorio();
    });

    btnPrevPage.addEventListener('click', () => {
      if (paginaActual > 1) {
        paginaActual--;
        cargarDirectorio();
      }
    });

    btnNextPage.addEventListener('click', () => {
      paginaActual++;
      cargarDirectorio();
    });

    // Modal Cancelar Eventos
    function ocultarModalCancelar(): void {
      modalCancelar.classList.add('hidden');
      modalCancelar.classList.remove('flex');
      citaParaCancelarId = null;
    }

    btnCerrarModalCancelar.addEventListener('click', ocultarModalCancelar);
    btnAbortarCancelar.addEventListener('click', ocultarModalCancelar);

    btnConfirmarCancelar.addEventListener('click', async () => {
      if (!citaParaCancelarId) return;
      try {
        btnConfirmarCancelar.textContent = 'Cancelando...';
        await cancelarCitaApi(citaParaCancelarId);
        ocultarModalCancelar();
        await cargarDirectorio();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Error al cancelar la cita');
      } finally {
        btnConfirmarCancelar.textContent = 'Sí, cancelar cita';
      }
    });

    // Iniciar
    actualizarEstilosTabs();
    actualizarEstilosTiempo();
    void cargarFiltrosIniciales();
    void cargarDirectorio();
  </script>
</AppLayout>
