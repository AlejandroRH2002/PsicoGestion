---
import AppLayout from '../../layouts/AppLayout.astro';
import AgendaControles from '../../components/citas/AgendaControles.astro';
import AgendaNavegacion from '../../components/citas/AgendaNavegacion.astro';
import VistaMes from '../../components/citas/VistaMes.astro';
import VistaSemana from '../../components/citas/VistaSemana.astro';
import VistaDia from '../../components/citas/VistaDia.astro';
import ModalImpresion from '../../components/citas/ModalImpresion.astro';
---

<AppLayout title="Agenda" subtitulo="Gestión y visualización de citas programadas" activo="citas" volverHref="/citas" volverEtiqueta="Volver al Directorio">
  <div class="w-full max-w-7xl flex flex-col gap-6">
    <!-- Encabezado con selector de vistas y acción de impresión -->
    <AgendaControles />

    <!-- Tarjeta Principal del Calendario -->
    <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs flex flex-col gap-6">
      <!-- Navegación temporal (mes/semana/día) -->
      <AgendaNavegacion />

      <!-- Vistas Modulares del Calendario -->
      <VistaMes />
      <VistaSemana />
      <VistaDia />
    </div>
  </div>

  <!-- Modal de Vista Previa de Impresión -->
  <ModalImpresion />

  <script>
    import { inicializarAgenda } from '../../utils/agendaController';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', inicializarAgenda);
    } else {
      inicializarAgenda();
    }
  </script>
</AppLayout>
