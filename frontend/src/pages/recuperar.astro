---
import AuthLayout from '../layouts/AuthLayout.astro';
import BrandHeader from '../components/BrandHeader.astro';
import FormInput from '../components/FormInput.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import { ArrowLeft } from '@lucide/astro';
---

<AuthLayout title="Recuperar Contraseña">
  <BrandHeader alignment="center" subtitle="UADY • Facultad de Psicología" />

  <section class="flex flex-col gap-1.5 mt-2">
    <h1 class="text-xl sm:text-2xl font-bold leading-[130%] text-[#0F172A]">Recuperar contraseña</h1>
    <p class="text-sm leading-[150%] text-[#64748B]">
      Ingresa tu correo electrónico institucional para enviarte un código de verificación.
    </p>
  </section>

  <form id="recover-form" class="flex flex-col gap-5 mt-4" novalidate>
    <div id="form-message" role="alert" class="hidden text-sm rounded-lg px-3.5 py-2.5 bg-red-50 text-red-700"></div>

    <div class="flex flex-col gap-1.5">
      <FormInput
        id="correo"
        name="correo"
        type="email"
        label="Correo institucional UADY"
        placeholder="ejemplo@correo.uady.mx"
        icon="mail"
        required
      />
      <!-- Mensaje de ayuda dinámico -->
      <span id="email-hint" class="text-xs leading-[140%] text-[#64748B] hidden mt-1">
        Debe ser terminación @correo.uady.mx o @uady.mx
      </span>
    </div>

    <PrimaryButton type="submit" id="submit-recover">
      Enviar código de verificación
    </PrimaryButton>
  </form>

  <div class="flex justify-center mt-2">
    <a
      href="/"
      class="flex items-center gap-2 text-sm font-medium text-[#64748B] hover:text-[#334155] transition-colors"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Volver al inicio de sesión</span>
    </a>
  </div>
</AuthLayout>

<script>
  import { isUadyEmail } from '../utils/email';

  const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';

  function initRecoverForm() {
    const form = document.getElementById('recover-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('correo') as HTMLInputElement | null;
    const emailHint = document.getElementById('email-hint') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-recover') as HTMLButtonElement | null;
    const formMessage = document.getElementById('form-message') as HTMLElement | null;
    const submitText = submitBtn?.textContent?.trim() ?? '';

    const showError = (text: string) => {
      if (!formMessage) return;
      formMessage.textContent = text;
      formMessage.classList.remove('hidden');
    };

    const setLoading = (isLoading: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = isLoading;
      submitBtn.textContent = isLoading ? 'Enviando código…' : submitText;
    };

    emailInput?.addEventListener('input', () => {
      const val = emailInput.value.trim();
      
      if (!val) {
        emailHint?.classList.add('hidden');
        emailHint?.classList.remove('text-red-500', 'text-[#0D9488]');
        return;
      }
      
      emailHint?.classList.remove('hidden');
      const isValid = isUadyEmail(val);
      
      if (isValid) {
        emailHint?.classList.remove('text-[#64748B]', 'text-red-500');
        emailHint?.classList.add('text-[#0D9488]');
      } else {
        emailHint?.classList.remove('text-[#64748B]', 'text-[#0D9488]');
        emailHint?.classList.add('text-red-500');
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      formMessage?.classList.add('hidden');
      const email = emailInput?.value.trim().toLowerCase() || '';

      if (!isUadyEmail(email)) {
        showError('Por favor ingresa tu correo institucional de la UADY válido.');
        emailInput?.focus();
        return;
      }

      setLoading(true);
      try {
        const response = await fetch(`${API_URL}/auth/recover/request`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ correo: email }),
        });

        if (response.ok) {
          window.location.href = `/verificar-correo?correo=${encodeURIComponent(email)}`;
          return;
        }

        const body = await response.json().catch(() => null);
        showError(body?.errors?.[0]?.message ?? body?.error ?? 'No se pudo enviar el código. Intenta de nuevo.');
      } catch {
        showError('No se pudo conectar con el servidor. Verifica tu conexión e intenta de nuevo.');
      }
      setLoading(false);
    });
  }

  // Soporte para View Transitions de Astro (si las habilitas)
  document.addEventListener('astro:page-load', initRecoverForm);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecoverForm);
  } else {
    initRecoverForm();
  }
</script>