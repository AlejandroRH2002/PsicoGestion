---
import AppLayout from '../../layouts/AppLayout.astro';
import CampoTexto from '../../components/CampoTexto.astro';
import FotoUploader from '../../components/FotoUploader.astro';
---
<AppLayout
  title="Registrar Nuevo Terapeuta"
  activo="terapeutas"
  volverHref="/terapeutas"
  volverEtiqueta="Volver a terapeutas"
>
  <form
    id="terapeuta-form"
    novalidate
    class="flex flex-col gap-6 w-full max-w-[640px] shrink-0 p-6 sm:p-8 bg-white rounded-2xl shadow-[0px_4px_12px_rgba(15,23,42,0.03)]"
  >
    <div class="flex flex-col gap-1.5">
      <h2 class="text-lg font-bold text-[#0F172A]">Información Profesional y de Contacto</h2>
      <p class="text-[13px] text-[#64748B]">Complete el formulario para dar de alta al nuevo terapeuta en el sistema.</p>
    </div>

    <!-- Mensaje general del servidor (éxito o error de conexión) -->
    <div id="form-message" role="alert" class="hidden text-sm rounded-lg px-3.5 py-2.5"></div>

    <!-- RF 2.1.11-2.1.13 -->
    <FotoUploader id="foto" label="Foto de perfil" />

    <div class="flex flex-col gap-5">
      <!-- RF 2.1.3 -->
      <CampoTexto
        id="nombre"
        label="Nombre completo"
        placeholder="Ej. María García López"
        maxlength={50}
        contador
        ayuda="Máximo 50 caracteres"
        autocomplete="name"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-4">
        <!-- RF 2.1.5 -->
        <CampoTexto
          id="telefono"
          label="Teléfono"
          type="tel"
          inputmode="tel"
          placeholder="Ej. 999 123 4567"
          ayuda="Debe ser de 10 dígitos"
          autocomplete="tel-national"
        />
        <!-- RF 2.1.8-2.1.9 -->
        <CampoTexto
          id="fechaNacimiento"
          label="Fecha de nacimiento"
          inputmode="numeric"
          maxlength={10}
          placeholder="dd/mm/aaaa"
          ayuda="Formato: dd/mm/aaaa"
        />
      </div>

      <!-- RF 2.1.7 -->
      <CampoTexto
        id="correo"
        label="Correo electrónico"
        type="email"
        inputmode="email"
        maxlength={100}
        placeholder="Ej. maria.garcia@correo.uady.mx"
        ayuda="Debe ser único e institucional"
        autocomplete="email"
      />

      <CampoTexto
        id="cedula"
        label="Cédula profesional"
        inputmode="numeric"
        maxlength={8}
        placeholder="Ej. 12345678"
        ayuda="Cédula federal emitida por la SEP"
      />
    </div>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
      <a
        href="/terapeutas"
        class="flex items-center justify-center px-6 py-3 bg-white border border-[#E2E8F0] rounded-lg text-sm font-semibold text-[#334155] hover:bg-[#F4F7F6] transition-colors"
      >
        Cancelar
      </a>
      <button
        type="submit"
        id="submit-btn"
        class="flex items-center justify-center px-6 py-3 bg-[#0D9488] hover:bg-[#0F766E] disabled:opacity-60 disabled:cursor-not-allowed rounded-lg text-sm font-semibold text-white transition-colors cursor-pointer active:scale-[0.99]"
      >
        Guardar Terapeuta
      </button>
    </div>
  </form>
</AppLayout>

<script>
  import { isUadyEmail } from '../../utils/email';
  import { API_URL } from '../../utils/sesion';

  interface FieldError {
    field: string;
    message: string;
  }

  const CAMPOS = ['foto', 'nombre', 'telefono', 'fechaNacimiento', 'correo', 'cedula'] as const;
  type Campo = (typeof CAMPOS)[number];

  const form = document.getElementById('terapeuta-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message') as HTMLElement;
  const input = (campo: Campo) => document.getElementById(campo) as HTMLInputElement;

  // --- Máscaras de entrada ---

  const contador = document.getElementById('nombre-contador');
  input('nombre').addEventListener('input', () => {
    if (contador) contador.textContent = `${input('nombre').value.length} / 50`;
  });

  input('telefono').addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const d = target.value.replace(/\D/g, '').slice(0, 10);
    target.value = d.length > 6 ? `${d.slice(0, 3)} ${d.slice(3, 6)} ${d.slice(6)}` : d.length > 3 ? `${d.slice(0, 3)} ${d.slice(3)}` : d;
  });

  input('fechaNacimiento').addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const d = target.value.replace(/\D/g, '').slice(0, 8);
    target.value = d.length > 4 ? `${d.slice(0, 2)}/${d.slice(2, 4)}/${d.slice(4)}` : d.length > 2 ? `${d.slice(0, 2)}/${d.slice(2)}` : d;
  });

  input('cedula').addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    target.value = target.value.replace(/\D/g, '').slice(0, 8);
  });

  // --- Errores por campo ---

  function mostrarError(campo: string, mensaje: string | null): void {
    const el = document.getElementById(`${campo}-error`);
    if (el) {
      el.textContent = mensaje ?? '';
      el.classList.toggle('hidden', !mensaje);
    }
    const control = document.getElementById(campo);
    if (control && campo !== 'foto') {
      if (mensaje) control.setAttribute('aria-invalid', 'true');
      else control.removeAttribute('aria-invalid');
    }
  }

  function limpiarErrores(): void {
    CAMPOS.forEach((campo) => mostrarError(campo, null));
    formMessage.classList.add('hidden');
  }

  CAMPOS.filter((c) => c !== 'foto').forEach((campo) => {
    input(campo).addEventListener('input', () => mostrarError(campo, null));
  });

  function showMessage(text: string, kind: 'error' | 'success'): void {
    formMessage.textContent = text;
    formMessage.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-green-50', 'text-green-700');
    formMessage.classList.add(...(kind === 'error' ? ['bg-red-50', 'text-red-700'] : ['bg-green-50', 'text-green-700']));
  }

  // --- Validación en cliente (mismas reglas y mensajes que backend/src/validators/terapeuta.validators.js) ---

  function validarFecha(valor: string): string | null {
    const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(valor);
    if (!match) return 'La fecha de nacimiento debe tener el formato dd/mm/aaaa.';
    const [dia, mes, anio] = [Number(match[1]), Number(match[2]), Number(match[3])];
    const fecha = new Date(anio, mes - 1, dia);
    if (fecha.getFullYear() !== anio || fecha.getMonth() !== mes - 1 || fecha.getDate() !== dia) {
      return 'La fecha de nacimiento no es una fecha válida.';
    }
    const hoy = new Date();
    if (fecha >= new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate())) {
      return 'La fecha de nacimiento debe ser anterior a la fecha de registro.';
    }
    return null;
  }

  function validar(): FieldError[] {
    const errores: FieldError[] = [];
    const nombre = input('nombre').value.trim();
    const telefono = input('telefono').value.replace(/\D/g, '');
    const fecha = input('fechaNacimiento').value.trim();
    const correo = input('correo').value.trim();
    const cedula = input('cedula').value.replace(/\D/g, '');

    if (!nombre) errores.push({ field: 'nombre', message: 'El nombre completo es obligatorio.' });
    else if (nombre.length > 50) errores.push({ field: 'nombre', message: 'El nombre completo no puede exceder 50 caracteres.' });

    if (!telefono) errores.push({ field: 'telefono', message: 'El número telefónico es obligatorio.' });
    else if (telefono.length !== 10) errores.push({ field: 'telefono', message: 'El número telefónico debe tener 10 dígitos.' });

    if (!fecha) errores.push({ field: 'fechaNacimiento', message: 'La fecha de nacimiento es obligatoria.' });
    else {
      const error = validarFecha(fecha);
      if (error) errores.push({ field: 'fechaNacimiento', message: error });
    }

    if (!correo) errores.push({ field: 'correo', message: 'El correo institucional es obligatorio.' });
    else if (!isUadyEmail(correo)) errores.push({ field: 'correo', message: 'El correo debe terminar en @correo.uady.mx o @uady.mx.' });

    if (!cedula) errores.push({ field: 'cedula', message: 'La cédula profesional es obligatoria.' });
    else if (!/^\d{7,8}$/.test(cedula)) errores.push({ field: 'cedula', message: 'La cédula profesional debe tener 7 u 8 dígitos.' });

    return errores;
  }

  function mostrarErrores(errores: FieldError[]): void {
    errores.forEach(({ field, message }) => mostrarError(field, message));
    const primero = errores.find((e) => CAMPOS.includes(e.field as Campo));
    if (primero) input(primero.field as Campo).focus();
    else if (errores[0]) showMessage(errores[0].message, 'error');
  }

  // --- Envío ---

  function setLoading(cargando: boolean): void {
    submitBtn.disabled = cargando;
    submitBtn.textContent = cargando ? 'Guardando…' : 'Guardar Terapeuta';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    limpiarErrores();

    const errores = validar();
    if (errores.length > 0) {
      mostrarErrores(errores);
      return;
    }

    const datos = new FormData();
    datos.append('nombre', input('nombre').value.trim());
    datos.append('telefono', input('telefono').value);
    datos.append('fechaNacimiento', input('fechaNacimiento').value.trim());
    datos.append('correo', input('correo').value.trim());
    datos.append('cedula', input('cedula').value);
    const foto = input('foto').files?.[0];
    if (foto) datos.append('foto', foto);

    setLoading(true);
    try {
      const response = await fetch(`${API_URL}/terapeutas`, { method: 'POST', credentials: 'include', body: datos });
      const body = await response.json().catch(() => null);

      if (response.ok) {
        showMessage('Terapeuta registrado correctamente. Redirigiendo…', 'success');
        window.setTimeout(() => {
          window.location.href = '/terapeutas?registrado=1';
        }, 1200);
        return;
      }

      if (response.status === 401) {
        showMessage('Tu sesión expiró. Inicia sesión de nuevo para guardar el terapeuta.', 'error');
      } else if (body?.errors?.length) {
        mostrarErrores(body.errors);
      } else {
        showMessage(body?.error ?? 'No se pudo registrar al terapeuta. Intenta de nuevo.', 'error');
      }
    } catch {
      // RNF 2.2.7: se informa el fallo sin perder los datos introducidos.
      showMessage('No se pudo conectar con el servidor. Tus datos siguen en el formulario; intenta de nuevo.', 'error');
    }
    setLoading(false);
  });
</script>
