---
interface Props {
  type?: 'submit' | 'button' | 'reset';
  id?: string;
  class?: string;
  disabled?: boolean;
}

const { type = 'submit', id, class: className = '', disabled = false } = Astro.props;
---
<button
  type={type}
  id={id}
  disabled={disabled}
  class={`w-full h-11 bg-[#0D9488] hover:bg-[#0F766E] text-white font-semibold text-sm rounded-lg
  flex items-center justify-center transition-colors shadow-sm cursor-pointer mt-1 active:scale-[0.99] gap-2
  disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:bg-[#0D9488] disabled:active:scale-100 ${className}`}
>
  <slot />
</button>