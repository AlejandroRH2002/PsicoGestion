---
import { Printer } from '@lucide/astro';
// Vista previa de impresión (RF 6.2). Comportamiento en utils/agenda-impresion.ts.
---
<dialog id="dialogo-impresion" aria-labelledby="impresion-titulo" class="m-auto w-[calc(100%-2rem)] max-w-[860px] p-0 rounded-2xl backdrop:bg-[#0F172A]/40 shadow-xl">
  <div class="flex flex-col gap-5 p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="impresion-titulo" class="text-xl font-semibold text-[#0F172A]">Vista previa de impresión</h2>
        <p class="mt-1 text-[13px] text-[#64748B]">Formato limpio optimizado para papel tamaño carta o PDF.</p>
      </div>
      <label class="flex items-center gap-2 text-[13px] text-[#334155]">
        <span id="imprimir-etiqueta">Fecha a imprimir:</span>
        <input id="imprimir-fecha" type="date" class="h-9 px-3 rounded-md bg-[#F1F5F9] text-[13px] font-semibold text-[#0F172A]" />
      </label>
    </div>
    <div id="vista-previa" class="max-h-[60vh] overflow-y-auto p-5 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC]"></div>
    <div class="flex justify-end gap-3">
      <button id="btn-cancelar-impresion" type="button" class="h-10 px-5 rounded-lg border border-[#E2E8F0] text-sm font-semibold text-[#334155] hover:bg-[#F8FAFC] cursor-pointer">Cancelar</button>
      <button id="btn-imprimir" type="button" disabled class="inline-flex items-center gap-2 h-10 px-5 rounded-lg bg-[#0D9488] text-white text-sm font-semibold hover:bg-[#0F766E] disabled:opacity-60 cursor-pointer">
        <Printer class="size-4" /> Imprimir
      </button>
    </div>
  </div>
</dialog>
