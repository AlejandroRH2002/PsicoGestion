---
import { Camera, User, X } from '@lucide/astro';

interface Props {
  id: string;
  label?: string;
  /** "zona": recuadro punteado del registro. "compacta": avatar + "Cambiar foto" de la edición. */
  variante?: 'zona' | 'compacta';
}

const { id, label = 'Foto de perfil', variante = 'zona' } = Astro.props;
---
<div class="flex flex-col gap-2 w-full" data-foto-uploader={id}>
  {variante === 'zona' ? (
    <>
      <span class="text-sm font-semibold text-[#0F172A]">{label}</span>

      <!-- Sin foto: zona para seleccionar archivo -->
      <label
        for={id}
        data-foto-vacia
        class="flex flex-col items-center justify-center gap-3 p-6 w-full rounded-xl border border-dashed border-[#0D9488] bg-[#CCFBF1]/10 hover:bg-[#CCFBF1]/30 cursor-pointer transition-colors focus-within:ring-2 focus-within:ring-[#0D9488]/30"
      >
        <span class="flex items-center justify-center size-12 rounded-full bg-[#CCFBF1] text-[#0D9488]">
          <Camera class="size-[22px]" />
        </span>
        <span class="flex flex-col items-center gap-1 text-center">
          <span class="text-sm font-semibold text-[#0D9488]">Haz clic para subir foto</span>
          <span class="text-xs text-[#64748B]">Mínimo 200x200 px • JPG o PNG</span>
        </span>
      </label>

      <!-- Con foto: vista previa -->
      <div data-foto-con-foto class="hidden items-center gap-4 p-4 w-full rounded-xl border border-[#E2E8F0] bg-white">
        <img data-foto-img alt="Vista previa de la foto de perfil" class="size-16 rounded-full object-cover shrink-0" />
        <div class="flex flex-col gap-0.5 min-w-0 flex-1">
          <span data-foto-nombre class="text-sm font-semibold text-[#0F172A] truncate"></span>
          <label for={id} class="text-xs font-semibold text-[#0D9488] hover:underline cursor-pointer w-fit">Cambiar foto</label>
        </div>
        <button
          type="button"
          data-foto-quitar
          aria-label="Quitar foto"
          class="p-2 rounded-lg text-[#64748B] hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
        >
          <X class="size-4" />
        </button>
      </div>
    </>
  ) : (
    <div class="flex items-center gap-4 w-full">
      <span class="relative flex items-center justify-center size-[72px] shrink-0 rounded-full bg-[#CCFBF1] text-[#0D9488] overflow-hidden">
        <User data-foto-vacia class="size-9" />
        <img data-foto-img alt="Foto de perfil" class="hidden absolute inset-0 size-full object-cover" />
      </span>
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center gap-2">
          <label
            for={id}
            class="px-3.5 py-2 bg-white border border-[#E2E8F0] rounded-lg text-[13px] font-semibold text-[#334155] hover:bg-[#F4F7F6] cursor-pointer transition-colors focus-within:ring-2 focus-within:ring-[#0D9488]/30"
          >
            Cambiar foto
          </label>
          <button
            type="button"
            data-foto-quitar
            data-foto-con-foto
            class="hidden px-2 py-2 text-[13px] font-semibold text-[#64748B] hover:text-red-600 cursor-pointer transition-colors"
          >
            Quitar
          </button>
        </div>
        <span class="text-xs text-[#64748B]">JPG o PNG • mínimo 200x200 px • máximo 5 MB</span>
      </div>
    </div>
  )}

  <input id={id} name={id} type="file" accept="image/jpeg,image/png" class="sr-only" aria-describedby={`${id}-error`} />
  <p id={`${id}-error`} class="hidden text-xs text-red-600"></p>
</div>

<script>
  import { validarFotoPerfil } from '../utils/imagen';

  // RF 2.1.11-2.1.13: la foto se valida antes de aceptarla; si no es válida el input queda vacío.
  //
  // La página puede indicar la foto ya guardada con el evento "foto:actual" (detail = URL o null).
  // Si el usuario quita esa foto sin elegir otra, la raíz queda con data-quitar="1".
  document.querySelectorAll<HTMLElement>('[data-foto-uploader]').forEach((raiz) => {
    const input = raiz.querySelector<HTMLInputElement>('input[type="file"]')!;
    const img = raiz.querySelector<HTMLImageElement>('[data-foto-img]')!;
    const nombre = raiz.querySelector<HTMLElement>('[data-foto-nombre]');
    const error = raiz.querySelector<HTMLElement>(`#${input.id}-error`)!;
    let urlObjeto: string | null = null;

    // Foto guardada en el servidor (edición) y última foto nueva válida elegida.
    let fotoActual: string | null = null;
    let ultimaValida: File | null = null;

    function mostrarError(mensaje: string | null): void {
      error.textContent = mensaje ?? '';
      error.classList.toggle('hidden', !mensaje);
    }

    /** Muestra la foto nueva si hay, si no la guardada (salvo que se haya quitado). */
    function pintar(): void {
      if (urlObjeto) URL.revokeObjectURL(urlObjeto);
      urlObjeto = ultimaValida ? URL.createObjectURL(ultimaValida) : null;
      const quitada = raiz.dataset.quitar === '1';
      const src = urlObjeto ?? (quitada ? null : fotoActual);

      if (src) img.src = src;
      else img.removeAttribute('src');
      img.classList.toggle('hidden', !src);
      if (nombre) nombre.textContent = ultimaValida?.name ?? 'Foto actual';

      raiz.querySelectorAll<HTMLElement>('[data-foto-vacia]').forEach((el) => {
        el.classList.toggle('hidden', !!src);
        if (el.tagName === 'LABEL') el.classList.toggle('flex', !src);
      });
      raiz.querySelectorAll<HTMLElement>('[data-foto-con-foto]').forEach((el) => {
        el.classList.toggle('hidden', !src);
        if (el.tagName === 'DIV') el.classList.toggle('flex', !!src);
      });
    }

    function sincronizarInput(): void {
      const datos = new DataTransfer();
      if (ultimaValida) datos.items.add(ultimaValida);
      input.files = datos.files;
    }

    input.addEventListener('change', async () => {
      const archivo = input.files?.[0];
      if (!archivo) {
        sincronizarInput();
        return;
      }
      const mensaje = await validarFotoPerfil(archivo);
      if (mensaje) {
        mostrarError(mensaje);
      } else {
        mostrarError(null);
        ultimaValida = archivo;
        delete raiz.dataset.quitar;
      }
      sincronizarInput();
      pintar();
      raiz.dispatchEvent(new Event('foto:cambio', { bubbles: true }));
    });

    raiz.querySelector('[data-foto-quitar]')?.addEventListener('click', () => {
      if (ultimaValida) ultimaValida = null;
      else if (fotoActual) raiz.dataset.quitar = '1';
      mostrarError(null);
      sincronizarInput();
      pintar();
      raiz.dispatchEvent(new Event('foto:cambio', { bubbles: true }));
    });

    raiz.addEventListener('foto:actual', (e) => {
      fotoActual = (e as CustomEvent<string | null>).detail;
      pintar();
    });
  });
</script>
