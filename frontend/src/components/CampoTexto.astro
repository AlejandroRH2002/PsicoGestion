---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  type?: 'text' | 'email' | 'tel';
  inputmode?: 'text' | 'email' | 'tel' | 'numeric';
  maxlength?: number;
  /** Muestra "0 / maxlength" junto a la etiqueta. */
  contador?: boolean;
  ayuda?: string;
  autocomplete?: string;
}

const { id, label, placeholder, type = 'text', inputmode, maxlength, contador = false, ayuda, autocomplete = 'off' } =
  Astro.props;
---
<div class="flex flex-col gap-1.5 w-full" data-campo={id}>
  <div class="flex items-center justify-between">
    <label for={id} class="text-sm font-semibold text-[#0F172A]">{label}</label>
    {contador && maxlength && (
      <span id={`${id}-contador`} class="text-xs text-[#64748B]" aria-live="polite">0 / {maxlength}</span>
    )}
  </div>
  <input
    id={id}
    name={id}
    type={type}
    inputmode={inputmode}
    maxlength={maxlength}
    placeholder={placeholder}
    autocomplete={autocomplete}
    required
    aria-describedby={`${id}-ayuda ${id}-error`}
    class="w-full px-4 py-3 bg-white border border-[#E2E8F0] rounded-lg text-sm text-[#0F172A] placeholder:text-[#64748B] focus:outline-none focus:ring-2 focus:ring-[#0D9488]/20 focus:border-[#0D9488] aria-invalid:border-red-500 aria-invalid:focus:ring-red-500/20 transition-all"
  />
  {ayuda && <p id={`${id}-ayuda`} class="text-xs text-[#64748B]">{ayuda}</p>}
  <p id={`${id}-error`} class="hidden text-xs text-red-600"></p>
</div>
