---
// Pasos del alta de cita. El estado (actual/completado) lo actualiza utils/cita-nueva via data-paso.
const pasos = ['Selección', 'Horarios', 'Confirmación'];
---
<ol id="stepper" class="flex items-center gap-3 w-full max-w-[820px]" aria-label="Progreso">
  {pasos.map((nombre, i) => (
    <li class="flex items-center gap-3 flex-1 last:flex-none" data-paso={i + 1}>
      <span class="flex items-center gap-2 shrink-0">
        <span data-circulo class="flex items-center justify-center size-6 rounded-full text-[11px] font-semibold"></span>
        <span data-nombre class="text-[13px] font-semibold">{nombre}</span>
      </span>
      {i < pasos.length - 1 && <span data-linea class="h-0.5 flex-1 rounded-full"></span>}
    </li>
  ))}
</ol>
