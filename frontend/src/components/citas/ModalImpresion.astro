---
import { Printer } from '@lucide/astro';
---

<div
  id="modal-impresion"
  class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-xs p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-impresion-titulo"
>
  <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full p-6 md:p-8 flex flex-col gap-6 border border-slate-100 animate-in fade-in zoom-in-95 duration-150">
    <!-- Cabecera del Modal -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div>
        <h3 id="modal-impresion-titulo" class="text-xl font-bold text-[#0F172A]">Vista previa de impresión</h3>
        <p class="text-xs text-[#64748B]">Formato limpio optimizado para papel o PDF</p>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto text-xs text-[#64748B]">
        <span>Fecha a imprimir:</span>
        <span id="print-fecha-badge" class="px-3 py-1.5 bg-slate-50 border border-[#E2E8F0] rounded-lg font-bold text-[#0F172A]">
          12 / Octubre / 2026
        </span>
      </div>
    </div>

    <!-- Hoja / Documento para Impresión (Área Imprimible) -->
    <div id="area-imprimible" class="bg-white border border-[#E2E8F0] rounded-xl p-6 shadow-2xs">
      <!-- Encabezado Institucional del Documento -->
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3">
        <div>
          <h4 class="text-base font-extrabold text-[#006847]">PsicGestión UADY - Agenda Diaria</h4>
          <p class="text-xs text-[#64748B]">Facultad de Psicología, Clínica de Control</p>
        </div>
        <div class="text-right">
          <span id="print-doc-fecha" class="text-xs md:text-sm font-bold text-[#0F172A]">
            Lunes, 12 Oct 2026
          </span>
        </div>
      </div>

      <!-- Tabla Limpia de Citas Diarias -->
      <div class="overflow-x-auto mt-4">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-slate-200 text-[11px] font-bold uppercase text-[#64748B]">
              <th class="py-2.5 px-3">HORA</th>
              <th class="py-2.5 px-3">PACIENTE</th>
              <th class="py-2.5 px-3">TERAPEUTA</th>
              <th class="py-2.5 px-3">SALA / CONSULTORIO</th>
            </tr>
          </thead>
          <tbody id="print-table-body" class="divide-y divide-slate-100 text-[#0F172A]">
            <!-- Rellenado dinámicamente -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Acciones del Modal -->
    <div class="flex items-center justify-end gap-3 pt-2">
      <button
        type="button"
        id="btn-cerrar-imprimir"
        class="px-5 py-2.5 rounded-lg border border-[#E2E8F0] text-sm font-semibold text-[#334155] hover:bg-slate-50 transition-colors cursor-pointer"
      >
        Cancelar
      </button>
      <button
        type="button"
        id="btn-ejecutar-imprimir"
        class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#0D9488] hover:bg-[#0F766E] text-white text-sm font-semibold transition-colors shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#0D9488]/40"
      >
        <Printer class="size-4" />
        <span>Imprimir</span>
      </button>
    </div>
  </div>
</div>

<style>
  @media print {
    /* Ocultar todo el sitio salvo el área imprimible */
    body * {
      visibility: hidden !important;
    }
    #area-imprimible,
    #area-imprimible * {
      visibility: visible !important;
    }
    #area-imprimible {
      position: fixed !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 24px !important;
      border: none !important;
      box-shadow: none !important;
      background: white !important;
      z-index: 999999 !important;
    }
    #modal-impresion {
      background: transparent !important;
      position: static !important;
      display: block !important;
      padding: 0 !important;
    }
  }
</style>
