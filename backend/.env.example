PORT=3001
NODE_ENV=development

# Debe coincidir con el docker-compose.yml de la raíz del repo
DATABASE_URL=postgres://psicogestion:psicogestion@localhost:5434/psicogestion

# Genera uno propio en cada entorno (ej. `openssl rand -hex 32`); nunca lo commitees.
JWT_SECRET=changeme-generate-a-long-random-secret

# Origen exacto del frontend en dev (Astro), para CORS con credenciales.
FRONTEND_ORIGIN=http://localhost:4321

# Solo para pruebas locales: dominios de correo extra aceptados además de @correo.uady.mx y @uady.mx,
# separados por comas (ej. alumnos.uady.mx). Debe coincidir con PUBLIC_EXTRA_EMAIL_DOMAINS del frontend.
# Déjalo vacío en producción.
EXTRA_EMAIL_DOMAINS=

# Correo saliente (códigos de recuperación de contraseña).
# Si SMTP_HOST se deja vacío en desarrollo, el correo se imprime en la consola del backend.
# Ej. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PsicoGestión UADY <no-reply@psicogestion.local>"
