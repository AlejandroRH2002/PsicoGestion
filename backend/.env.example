PORT=3001
NODE_ENV=development

# Debe coincidir con el docker-compose.yml de la raíz del repo
DATABASE_URL=postgres://psicogestion:psicogestion@localhost:5434/psicogestion

# Genera uno propio en cada entorno (ej. `openssl rand -hex 32`); nunca lo commitees.
JWT_SECRET=changeme-generate-a-long-random-secret

# Origen exacto del frontend en dev (Astro), para CORS con credenciales.
FRONTEND_ORIGIN=http://localhost:4321
